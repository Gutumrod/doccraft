{
  "name": "doccraft",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.21.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "postbuild": "node scripts/finalize-security-headers.mjs",
    "start": "node scripts/serve-static.mjs",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "pnpm build && playwright test",
    "test:security-boundary": "node scripts/security-boundary-selftest.mjs",
    "smoke:prod": "node scripts/phase6-production-smoke.mjs",
    "deploy:http-redirect": "pnpm dlx wrangler@4.129.0 deploy -c wrangler.http-redirect.jsonc",
    "deploy:main": "pnpm dlx wrangler@4.129.0 deploy -c wrangler.jsonc",
    "deploy": "pnpm build && pnpm run deploy:http-redirect && pnpm run deploy:main"
  },
  "dependencies": {
    "next": "16.3.3",
    "qrcode.react": "4.2.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "20.19.43",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.3",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  }
}
